# Copy to .env for local `vercel dev`, or set in Vercel Project Settings → Environment Variables.

DEEPSEEK_API_KEY=sk-your-deepseek-key

# Optional
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com

# Comma-separated origins allowed to call the API (your GitHub Pages URL + local dev)
# Tip: use * for best iOS/Android compatibility
ALLOWED_ORIGINS=*

# Set to false to stop ALL DeepSeek calls on the server (required to fully pause billing)
API_ENABLED=false
