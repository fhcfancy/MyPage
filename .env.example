# Copy to .env for local `vercel dev`, or set in Vercel Project Settings → Environment Variables.

DEEPSEEK_API_KEY=sk-your-deepseek-key

# Optional
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com

# Comma-separated origins allowed to call the API (your GitHub Pages URL + local dev)
ALLOWED_ORIGINS=https://fhcfancy.github.io,https://fhcfancy.github.io/MyPage,http://localhost:8000,http://127.0.0.1:8000
